:18,"midi":62,"string":3,"fret":7,"name":"D4","start":9,"duration":0.5,"bar":3,"beat":2},{"index":19,"midi":60,"string":3,"fret":5,"name":"C4","start":9.5,"duration":0.5,"bar":3,"beat":2.5},{"index":20,"midi":61,"string":3,"fret":6,"name":"C♯4","start":10,"duration":0.5,"bar":3,"beat":3},{"index":21,"midi":58,"string":4,"fret":8,"name":"B♭3","start":10.5,"duration":0.5,"bar":3,"beat":3.5},{"index":22,"midi":55,"string":4,"fret":5,"name":"G3","start":11,"duration":0.5,"bar":3,"beat":4},{"index":23,"midi":56,"string":4,"fret":6,"name":"G♯3","start":11.5,"duration":0.5,"bar":3,"beat":4.5,"kind":"approach","analysis":{"verified":true,"description":"G♯ 半音上行到下一段的 A（Dm7 的 5）"}},{"index":24,"midi":57,"string":4,"fret":7,"name":"A3","start":12,"duration":1,"bar":4,"beat":1},{"index":25,"midi":53,"string":5,"fret":8,"name":"F3","start":13,"duration":0.5,"bar":4,"beat":2},{"index":26,"midi":50,"string":5,"fret":5,"name":"D3","start":13.5,"duration":0.5,"bar":4,"beat":2.5},{"index":27,"midi":53,"string":5,"fret":8,"name":"F3","start":14,"duration":2,"bar":4,"beat":3}],"chords":[{"name":"Cmaj7","start":0,"duration":2,"bar":1,"beat":1,"precision":"source-score"},{"name":"A7","start":2,"duration":2,"bar":1,"beat":3,"precision":"source-score"},{"name":"Dm7","start":4,"duration":2,"bar":2,"beat":1,"precision":"source-score"},{"name":"G7","start":6,"duration":2,"bar":2,"beat":3,"precision":"source-score"},{"name":"Cmaj7","start":8,"duration":2,"bar":3,"beat":1,"precision":"source-score"},{"name":"A7","start":10,"duration":2,"bar":3,"beat":3,"precision":"source-score"},{"name":"Dm7","start":12,"duration":2,"bar":4,"beat":1,"precision":"source-score"},{"name":"G7","start":14,"duration":2,"bar":4,"beat":3,"precision":"source-score"}],"segments":[{"start":0,"duration":2,"title":"从中低弦走向高处","text":"E–G–B–D = 3–5–7–9：像 Em7 的琶音，放在 Cmaj7 上形成无根音 Cmaj9 色彩。先看 C 的 A 形与 G 形重叠，再把 D 当作 C4 上方两品的 9。"},{"start":2,"duration":2,"title":"同样的 E、G，换一个角色","text":"C♯–E–G–B♭ = 3–5–♭7–♭9：C♯dim7 的音组成无根音 A7♭9。E4（2/5）回到 E3（5/7），G4（1/3）回到 G3（4/5）：音名相同，和弦角色改变。B♭ 再下半音解决到 Dm7 的 A。"},{"start":4,"duration":2,"title":"落在 Dm7 的骨架上","text":"A–F–D–C = 5–♭3–1–♭7。把高处的 A4 连回 A3（4 弦 7 品），再连回 A2（6 弦 5 品）。同一个 A，在 A7 是根音，在 Dm7 是五音。"},{"start":6,"duration":2,"title":"骨架之后，再加入张力","text":"B–G–A♭–B♭ = 3–1–♭9–♯9。A♭、B♭ 是 G7 上的变化张力；这里不是普通的 C 大调音阶。观察下一段回到 G 的方向，不把所有音硬塞进一个音阶框。"},{"start":8,"duration":2,"title":"用八度桥接回 C","text":"G–E–D–C = 5–3–9–1。E4（2 弦 5 品）与开头的 E3（5 弦 7 品）相差一个八度；先把这个桥记牢，再听 9 落回根音。"},{"start":10,"duration":2,"title":"把趋近音指向落点","text":"C♯–B♭–G 是 3–♭9–♭7；最后 G♯ 半音上行到下一段的 A。这里把 G♯ 标为趋近音，不当成 A7 的稳定骨架，也不因为 C♯ 不在 C 大调里就叫它经过音。"},{"start":12,"duration":2,"title":"回到熟悉的中低弦","text":"A–F–D = 5–♭3–1。A 是一拍，F 与 D 各半拍。刚才高弦的 A4，现在落低一个八度到 4 弦 7 品；位置不同，Dm7 的五音角色不变。"},{"start":14,"duration":2,"title":"停在七音，听见下一轮","text":"最后的 F 持续两拍，是 G7 的 ♭7。留住这个音，再看下一轮 Cmaj7 开头 E：F→E 下行半音，把属七的七音连到主和弦的三音。"}],"audio":"https://bopland.org/data/Xbv40aTf.mp3","score":"https://bopland.org/data/Xbv40aTf.png","source":{"name":"BopLand.org","type":"bopland","url":"https://bopland.org/lick#Xbv40aTf/guitar-licks/","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0/","attribution":"Adapted from the BopLand.org guitar TAB. Source notes, not a newly generated phrase."},"timing":{"basis":"source-score","audioSync":"unverified","audioOffsetSeconds":null,"notationTempoKnown":false},"verification":{"method":"manual-source-TAB-and-rhythm-review","reviewed":"2026-10-04","scoreSha256":"36595f395d0141d4a861470cb5f528f1ef6afd0eb9656e6b682f6f5e2b4c1ad8","noteCount":28,"notes":"All 28 source string/fret positions and notated beat durations were checked against the original PNG. Audio tempo and note-to-audio alignment have not been verified."}}
